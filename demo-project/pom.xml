<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>dev.rabauer</groupId>
    <artifactId>dep-graph-demo</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Dependency Graph Demo</name>
    <description>
        "Zipper", a small multi-module build that uses the dep-graph-maven-plugin. Its modules disagree about
        a few library versions on purpose, so the generated page has something to show for every feature:
        version conflicts, dependencyManagement pins, version drift between modules and outdated releases.
    </description>

    <modules>
        <module>zipper-core</module>
        <module>zipper-web</module>
        <module>zipper-cli</module>
    </modules>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.rabauer</groupId>
                <artifactId>zipper-core</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Inherited by every module, but the plugin writes a single page for the whole reactor:
                 target/dep-graph.html next to this pom. -->
            <plugin>
                <groupId>dev.rabauer</groupId>
                <artifactId>dep-graph-maven-plugin</artifactId>
                <version>0.1.0-SNAPSHOT</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>graph</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
